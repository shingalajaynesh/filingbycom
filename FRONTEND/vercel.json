{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), camera=(), microphone=(), payment=*"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: blob: https:; connect-src 'self' https: http://localhost:3000; font-src 'self' data: https:; frame-src 'self' https:; object-src 'none';"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/pages/partnership-firm-return",
      "destination": "/services/partnership-firm",
      "permanent": true
    },
    {
      "source": "/pages/indian-subsidiary-registration",
      "destination": "/services/indian-subsidiary",
      "permanent": true
    },
    {
      "source": "/pages/income-tax-audit",
      "destination": "/services/tax-audit",
      "permanent": true
    },
    {
      "source": "/account",
      "destination": "/dashboard",
      "permanent": true
    },
    {
      "source": "/cart",
      "destination": "/dashboard",
      "permanent": true
    },
    {
      "source": "/search",
      "destination": "/dashboard",
      "permanent": true
    },
    {
      "source": "/pages/csr-audit",
      "destination": "/services/csr-registration",
      "permanent": true
    },
    {
      "source": "/pages/trust-compliance",
